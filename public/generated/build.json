{"html":"<h1 id=\"build\">Build</h1>\n<p>Build native programs, browser applications, and editor-supported projects. Choose the target first because host capabilities differ.</p>\n<ul><li><a href=\"./install.html\">Install and use the CLI</a> — set up native development.</li><li><a href=\"./browser.html\">Embed VKF in a webpage</a> — package the browser subset.</li><li><a href=\"./editor.html\">Use VS Code</a> — add language tooling.</li><li><a href=\"./testing.html\">Test programs</a> — run language and repository tests.</li><li><a href=\"https://github.com/svenviktorjonsson/vektor-flow/tree/main/examples\">Examples</a> — start from complete applications.</li></ul>\n<p><a href=\"./index.html\">Home</a></p>","headings":[{"level":1,"title":"Build","id":"build"}],"examples":[],"source":"docs/site/build.md","route":"build.html","releaseCatalog":{"schema":"vektor-flow/release-catalog-v1","latest":"0.4.7","latestBrowserRuntime":{"version":"0.4.7","url":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=42731514d3861908d0df15d5cc4a6ca0efea4c60f063ade86aeb0ccf55d92765"},"releases":[{"version":"0.4.7","tag":"v0.4.7","status":"published","browserRuntimeWasm":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=42731514d3861908d0df15d5cc4a6ca0efea4c60f063ade86aeb0ccf55d92765","benchmarkTier":"patch","benchmark":{"summary":"Local Windows, Linux, and Firefox comparisons; unmeasured cells remain explicit.","browser":null,"evidenceUrl":"https://vektorflow.org/performance.html"},"downloads":{"windows":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64-setup.exe?sha256=2e0c091f5ce343aebea386a4dba858086fdb574c20d4b387c4db68b6e74ea1ec","archive":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64.zip?sha256=160abc068711d036aa669ceaf42aaa1d9da49e83f28efe1aee51d169caed16e7"},"linux":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-linux-x64.deb?sha256=cb8a7371a7f8d21950e95a3df0cfedb652d1456