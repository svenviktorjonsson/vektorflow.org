{"html":"<h1 id=\"build\">Build</h1>\n<p>Build native programs, browser applications, and editor-supported projects. Choose the target first because host capabilities differ.</p>\n<ul><li><a href=\"./install.html\">Install and use the CLI</a> — set up native development.</li><li><a href=\"./browser.html\">Embed VKF in a webpage</a> — package the browser subset.</li><li><a href=\"./editor.html\">Use VS Code</a> — add language tooling.</li><li><a href=\"./testing.html\">Test programs</a> — run language and repository tests.</li><li><a href=\"https://github.com/svenviktorjonsson/vektor-flow/tree/main/examples\">Examples</a> — start from complete applications.</li></ul>\n<p><a href=\"./index.html\">Home</a></p>","headings":[{"level":1,"title":"Build","id":"build"}],"examples":[],"source":"docs/site/build.md","route":"build.html","releaseCatalog":{"schema":"vektor-flow/release-catalog-v1","latest":"0.4.7","latestBrowserRuntime":{"version":"0.4.7","url":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=d906c29e80bb4fa6ed3999379ad8679bc55a6ba708a50483fe09147437a1b3e9"},"releases":[{"version":"0.4.7","tag":"v0.4.7","status":"published","browserRuntimeWasm":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=d906c29e80bb4fa6ed3999379ad8679bc55a6ba708a50483fe09147437a1b3e9","benchmarkTier":"patch","benchmark":{"summary":"Local Windows, Linux, and Firefox comparisons; unmeasured cells remain explicit.","browser":null,"evidenceUrl":"https://vektorflow.org/performance.html"},"downloads":{"windows":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64-setup.exe?sha256=2f656c5cb9f3d4f8e544a2157c54dce1d73004e7296e842573da1acada27a955","archive":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64.zip?sha256=ca05457ebf22f79b4ec2807f486146e33c37fbd83a23059ef647f5de4c8884b4"},"linux":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-linux-x64.deb?sha256=2eccd6af9460a50538d7bbf06c09f3a77f695c4