{"html":"<h1 id=\"about\">About</h1>\n<p>VKF separates shipped behavior from planned work. These pages explain why the language exists, where it is going, and which architectural boundaries guide implementation.</p>\n<ul><li><a href=\"./coming-soon.html\">Roadmap</a> — see work in progress without release claims.</li><li><a href=\"./origins.html\">Origins</a> — understand the language's motivation and name.</li><li><a href=\"./execution.html\">Execution architecture</a> — inspect optimization boundaries.</li><li><a href=\"./ui-architecture.html\">UI architecture</a> — follow runtime ownership and data flow.</li><li><a href=\"./browser-architecture.html\">Browser architecture</a> — follow the browser compiler boundary.</li><li><a href=\"https://github.com/svenviktorjonsson/vektor-flow\">Source repository</a> — inspect code and history.</li></ul>\n<p><a href=\"./index.html\">Home</a></p>","headings":[{"level":1,"title":"About","id":"about"}],"examples":[],"source":"docs/site/about.md","route":"about.html","releaseCatalog":{"schema":"vektor-flow/release-catalog-v1","latest":"0.4.7","latestBrowserRuntime":{"version":"0.4.7","url":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=d906c29e80bb4fa6ed3999379ad8679bc55a6ba708a50483fe09147437a1b3e9"},"releases":[{"version":"0.4.7","tag":"v0.4.7","status":"published","browserRuntimeWasm":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=d906c29e80bb4fa6ed3999379ad8679bc55a6ba708a50483fe09147437a1b3e9","benchmarkTier":"patch","benchmark":{"summary":"Local Windows, Linux, and Firefox comparisons; unmeasured cells remain explicit.","browser":null,"evidenceUrl":"https://vektorflow.org/performance.html"},"downloads":{"windows":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64-setup.exe?sha256=2f656c5cb9f3d4f8e544a2157c54dce1d73004e7296e842573da1acada27a955","archive":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64.zip?sha256=ca05457ebf22f79b4ec