{"html":"<h1 id=\"about\">About</h1>\n<p>VKF separates shipped behavior from planned work. These pages explain why the language exists, where it is going, and which architectural boundaries guide implementation.</p>\n<ul><li><a href=\"./coming-soon.html\">Roadmap</a> — see work in progress without release claims.</li><li><a href=\"./origins.html\">Origins</a> — understand the language's motivation and name.</li><li><a href=\"./execution.html\">Execution architecture</a> — inspect optimization boundaries.</li><li><a href=\"./ui-architecture.html\">UI architecture</a> — follow runtime ownership and data flow.</li><li><a href=\"./browser-architecture.html\">Browser architecture</a> — follow the browser compiler boundary.</li><li><a href=\"https://github.com/svenviktorjonsson/vektor-flow\">Source repository</a> — inspect code and history.</li></ul>\n<p><a href=\"./index.html\">Home</a></p>","headings":[{"level":1,"title":"About","id":"about"}],"examples":[],"source":"docs/site/about.md","route":"about.html","releaseCatalog":{"schema":"vektor-flow/release-catalog-v1","latest":"0.4.7","latestBrowserRuntime":{"version":"0.4.7","url":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=42731514d3861908d0df15d5cc4a6ca0efea4c60f063ade86aeb0ccf55d92765"},"releases":[{"version":"0.4.7","tag":"v0.4.7","status":"published","browserRuntimeWasm":"https://vektorflow.org/runtimes/v0.4.7/vkf-shared-compiler.wasm?sha256=42731514d3861908d0df15d5cc4a6ca0efea4c60f063ade86aeb0ccf55d92765","benchmarkTier":"patch","benchmark":{"summary":"Local Windows, Linux, and Firefox comparisons; unmeasured cells remain explicit.","browser":null,"evidenceUrl":"https://vektorflow.org/performance.html"},"downloads":{"windows":{"installer":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64-setup.exe?sha256=2e0c091f5ce343aebea386a4dba858086fdb574c20d4b387c4db68b6e74ea1ec","archive":"https://vektorflow.org/downloads/v0.4.7/vektor-flow-windows-x64.zip?sha256=160abc068711d036aa6