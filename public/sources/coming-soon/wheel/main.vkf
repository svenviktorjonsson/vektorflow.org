# Complete executable application. Geometry/data are ordinary retained add layers.
: .ui.display
: .physics
: .math
geometry: .geometry
materials: .materials
particles: .particles

wheel_world: World(dim:2,time_step:1 / 240)
display: Display(dim:2)
water_view: display.append(wheel_world,axis:false)
wheel_rim: wheel_world.add(p_ij:geometry.rim(),properties:geometry.rim_properties)
wheel_baffles: wheel_world.add(p_ij:geometry.baffles,properties:geometry.baffle_properties)
fluid: wheel_world.add(p_ij:particles.water,properties:materials.water)
wheel_world.push((kind:"gravity",acceleration:[0,-9.82]))
wheel_world.push((kind:"contact",boundaries:[wheel_rim,wheel_baffles],rotation:0.22))
wheel_world.push((kind:"liquid",layer:fluid))
water_view.set(embedding:(kind:"material",layer:fluid),controls:(title:"Water in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))

sand_view: display.append(wheel_world,axis:false)
grains: wheel_world.add(p_ij:particles.sand,properties:materials.sand)
wheel_world.push((kind:"granular",layer:grains))
sand_view.set(embedding:(kind:"material",layer:grains),controls:(title:"Sand in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))
# Presentation state is retained View text, not a DOM row that changes layout.
water_status: water_view.add(at:[0.025,0.035],space:"relative",text:"WATER  |  %COUNT% vertices  |  D %DIAMETER% m  |  %MODE%",font_size:13,color:[0.65,0.77,0.77,1])
water_clock: water_view.add(at:[0.025,0.085],space:"relative",text:"t %TIME% s  |  wheel %ANGLE% rad",font_size:13,color:[0.65,0.77,0.77,1])
sand_status: sand_view.add(at:[0.025,0.035],space:"relative",text:"SAND  |  %COUNT% vertices  |  D %DIAMETER% m  |  %MODE%",font_size:13,color:[0.65,0.77,0.77,1])
sand_clock: sand_view.add(at:[0.025,0.085],space:"relative",text:"t %TIME% s  |  wheel %ANGLE% rad  |  wet %WETNESS%%",font_size:13,color:[0.65,0.77,0.77,1])
display.flip(water_view)
display.show()
