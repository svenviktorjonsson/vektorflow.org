# Complete executable application. Geometry/data are ordinary retained add layers.
: .ui.display
: .physics
: .math
geometry: .geometry
materials: .materials
particles: .particles

wheel_world: World(dim:2,time_step:1 / 240)
display: Display(dim:2)
water_view: display.append(wheel_world,axis:false)
wheel_rim: water_view.add(p_ij:geometry.rim(),properties:geometry.rim_properties)
wheel_baffles: water_view.add(p_ij:geometry.baffles,properties:geometry.baffle_properties)
fluid: water_view.add(p_ij:particles.water,properties:materials.water)
wheel_world.push((kind:"gravity",acceleration:[0,-9.82]))
wheel_world.push((kind:"contact",boundaries:[wheel_rim,wheel_baffles],rotation:0.22))
wheel_world.push((kind:"liquid",layer:fluid))
water_view.set(embedding:(kind:"material",layer:fluid),controls:(title:"Water in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))

sand_view: display.append(wheel_world,axis:false)
grains: sand_view.add(p_ij:particles.sand,properties:materials.sand)
wheel_world.push((kind:"granular",layer:grains))
sand_view.set(embedding:(kind:"material",layer:grains),controls:(title:"Sand in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))
display.flip(water_view)
display.show()
