# Complete executable application. Geometry/data are ordinary retained add layers.
: .ui.display
: .physics
: .math
geometry: .geometry
materials: .materials
particles: .particles

water_world: World(dim:2,time_step:1 / 240)
sand_world: World(dim:2,time_step:1 / 60)
display: Display(dim:2)
water_view: display.append(water_world,axis:false)
water_rim: water_view.add(p_ij:geometry.rim(),properties:geometry.rim_properties)
water_baffles: water_view.add(p_ij:geometry.baffles,properties:geometry.baffle_properties)
fluid: water_view.add(p_ij:particles.water,properties:materials.water)
water_world.push((kind:"gravity",acceleration:[0,-9.82]))
water_world.push((kind:"contact",boundaries:[water_rim,water_baffles],rotation:0.22))
water_world.push((kind:"liquid",layer:fluid))
water_view.set(embedding:(kind:"material",layer:fluid),controls:(title:"Water in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))

sand_view: display.append(sand_world,axis:false)
sand_rim: sand_view.add(p_ij:geometry.rim(),properties:geometry.rim_properties)
sand_baffles: sand_view.add(p_ij:geometry.baffles,properties:geometry.baffle_properties)
grains: sand_view.add(p_ij:particles.sand,properties:materials.sand)
sand_world.push((kind:"gravity",acceleration:[0,-9.82]))
sand_world.push((kind:"contact",boundaries:[sand_rim,sand_baffles],rotation:0.22))
sand_world.push((kind:"granular",layer:grains))
sand_view.set(embedding:(kind:"material",layer:grains),controls:(title:"Sand in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))
display.flip(water_view)
display.show()
