: .ui.display
: .physics
geometry: .geometry
materials: .materials

world: World(dim:3,time_step:1 / 120)
display: Display(dim:3)
view: display.append(world,axis:false)
tree: view.add(p_ij:[[0,0,0]],properties:materials.tree)
lawn: view.add(p_ij:[[-6,-6,0],[6,6,0]],properties:materials.lawn)
nodes: view.add(p_ij:geometry.nodes(),properties:materials.elastic)
sun: view.add(p_ij:[[-50,140,65]],properties:materials.sun)
air: view.add(p_ij:geometry.parcels(),properties:materials.air)
world.push((kind:"wind",layer:air,nodes:nodes,solid:tree,grass:lawn))
view.set(embedding:(kind:"scene",),controls:(title:"8 m tree · lawn · particle wind",orbit:true,wind:true,grass:true,particles:true,pause:true,reset:true))
display.show()
